# ── Required ──
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_workforce

# Initial admin (used by `npm run db:seed`; a random password is generated if unset)
ADMIN_EMAIL=admin@4ugenerators.local
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Shared secret for POST /api/cron/tick (Vercel Cron, n8n, any scheduler)
CRON_SECRET=

# ── AI providers (server-side only; never exposed to the browser) ──
ANTHROPIC_API_KEY=
XAI_API_KEY=

# ── Odoo Community CRM (duplicate prevention against existing partners) ──
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=

# ── Company ──
COMPANY_WEBSITE=https://www.4ugenerators.com/

# ── Worker ──
WORKER_POLL_MS=5000
